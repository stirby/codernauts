{
  "name": "codernauts-client-starter",
  "version": "0.1.0",
  "description": "Beginner-friendly TypeScript client starter kit for the Codernauts API-first space automation game.",
  "private": true,
  "type": "module",
  "bin": {
    "codernauts": "./src/cli.ts"
  },
  "scripts": {
    "bot": "tsx src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "web": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.20.5",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
